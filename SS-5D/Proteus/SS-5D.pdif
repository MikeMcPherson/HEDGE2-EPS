;Proteus Design Interchange Format
(PDIF
 (vendor "SamacSys Limited")
 (version 1 0)
 (library
  (part "SS-5D"
   (description "Subminiature Basic Switch,  125VAC, 5A, SPDT, Pin Plunger, OF:max. 1.47N, PCB Terminal")
   (family "SWI")
   (package "SS5D")
   (attribute "Datasheet Link" "https://components.omron.com/us-en/sites/components.omron.com.us/files/datasheet_pdf/B032-E1.pdf")
   (attribute "Geometry.Height" "11.9mm")
   (attribute "Manufacturer_Name" "OMRON Electronics")
   (attribute "Manufacturer_Part_Number" "SS-5D")
   (attribute "Mouser Part Number" "653-SS-5D")
   (attribute "Mouser Price/Stock" "https://www.mouser.co.uk/ProductDetail/Omron-Electronics/SS-5D/?qs=pWf36BUtxBh%252BlIUjzjOszg%3D%3D")
   (attribute "Arrow Part Number" "SS-5D")
   (attribute "Arrow Price/Stock" "https://www.arrow.com/en/products/ss5d/omron?region=europe")
   (gate
    (symbol "SS-5D")
    (pin "COM" 1 PS)
    (pin "NO" 2 PS)
    (pin "NC" 3 NC)
   )
  )
  (symbol "SS-5D"
   (units THOU)
   (origin (pt 0 0))
   (graphic
    (stroke 10)
    (path (pt 200 100) (pt 700 100) (pt 700 -300) (pt 200 -300) (pt 200 100) (closed))
   )
   (terminal
    (body (symbol "PIN") (pt 0 0) (rot 0) (mir 0) (visible true))
    (name (pt 230 0) (rot 0) (just MIDDLE LEFT) (visible true))
    (number (pt 140 20) (rot 0) (just BOTTOM RIGHT) (visible true)))
   (terminal
    (body (symbol "PIN") (pt 0 -100) (rot 0) (mir 0) (visible true))
    (name (pt 230 0) (rot 0) (just MIDDLE LEFT) (visible true))
    (number (pt 140 20) (rot 0) (just BOTTOM RIGHT) (visible true)))
   (terminal
    (body (symbol "PIN") (pt 0 -200) (rot 0) (mir 0) (visible true))
    (name (pt 230 0) (rot 0) (just MIDDLE LEFT) (visible true))
    (number (pt 140 20) (rot 0) (just BOTTOM RIGHT) (visible true)))
  )
  (symbol "PIN"
   (units THOU)
   (origin (pt 0 0))
   (graphic
    (stroke 10)
    (path (pt 0 0) (pt 200 0))))
  (symbol "PINSHORT"
   (units THOU)
   (origin (pt 0 0))
   (graphic
    (stroke 10)
    (path (pt 0 0) (pt 100 0))))
  (package "SS5D"
   (units MM)
   (layer TASM
    (graphic
     (stroke 0.2)
     (path
      (closed true)
      (pt -1.6 3.2)
      (pt 18.2 3.2)
      (pt 18.2 -3.2)
      (pt -1.6 -3.2)
      (pt -1.6 3.2))))
   (layer OCCA
    (graphic
     (stroke 0.1)
     (path
      (closed true)
      (pt -2.1 3.7)
      (pt 19.225 3.7)
      (pt 19.225 -3.7)
      (pt -2.1 -3.7)
      (pt -2.1 3.7))))
   (layer TSLK
    (graphic
     (stroke 0.1)
     (path
      (closed false)
      (pt -1.6 -1)
      (pt -1.6 -3.2)
      (pt 18.2 -3.2)
      (pt 18.2 -1.5))))
   (layer TSLK
    (graphic
     (stroke 0.1)
     (path
      (closed false)
      (pt -1.6 1)
      (pt -1.6 3)
      (pt -1.6 3.2)
      (pt 18.2 3.2)
      (pt 18.2 1.5))))
   (leg 1 (pt 0.000 0.000) (padstack 0))
   (leg 2 (pt 8.800 0.000) (padstack 0))
   (leg 3 (pt 16.100 0.000) (padstack 0))
   (padstack 0
    (hole 1.5)
    (plated true)
    (pad (layer TCOP) (round 2.250))
    (pad (layer INNER) (round 2.250))
    (pad (layer BCOP) (round 2.250))
   )
   (model "SS-5D.stp"
    (euler 0 0 0)
    (offset 0 0 0)
   )
  )
 )
)
